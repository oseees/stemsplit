generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URL lives in prisma.config.ts (Prisma 7 no longer allows `url` here).
}

enum Role {
  BUYER
  ADMIN
}

enum ProductCategory {
  PHONE
  TABLET
  LAPTOP
  ACCESSORY
  OTHER
}

enum CampaignStatus {
  OPEN
  MOQ_REACHED
  ORDERED_FROM_SUPPLIER
  SHIPPED
  DELIVERED
  FAILED_REFUNDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum PaymentTxnStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  SENT
  CONFIRMED
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  phone    String @unique // Nigerian format, e.g. +2348012345678
  fullName String @map("full_name")
  role     Role   @default(BUYER)

  // Single default shipping address is enough for now — Nigeria only.
  shippingStreet String? @map("shipping_street")
  shippingCity   String? @map("shipping_city")
  shippingState  String? @map("shipping_state")

  createdAt   DateTime     @default(now()) @map("created_at")
  commitments Commitment[]

  @@map("users")
}

model Supplier {
  id                String   @id @default(cuid())
  name              String
  contactPerson     String?  @map("contact_person")
  wechatOrWhatsapp  String?  @map("wechat_or_whatsapp")
  country           String   @default("China")
  paymentDetails    Json?    @map("payment_details") // bank/Alipay info; encrypt sensitive parts later
  notes             String?
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")

  products Product[]
  payouts  SupplierPayout[]

  @@map("suppliers")
}

model Product {
  id          String          @id @default(cuid())
  name        String
  description String?
  category    ProductCategory
  images      String[]        // URLs
  specs       Json?           // flexible per product type
  baseCostRmb Decimal         @map("base_cost_rmb") @db.Decimal(12, 2)

  supplierId String   @map("supplier_id")
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  createdAt DateTime   @default(now()) @map("created_at")
  campaigns Campaign[]

  @@index([supplierId])
  @@map("products")
}

model Campaign {
  id          String @id @default(cuid())
  title       String
  description String?

  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id])

  moq            Int
  maxUnits       Int?    @map("max_units")
  unitsCommitted Int     @default(0) @map("units_committed")

  // e.g. [{ "minUnits": 10, "pricePerUnitNaira": 85000 }, ...] — price improves with volume.
  priceTiers        Json    @map("price_tiers")
  currentTierPrice  Decimal @map("current_tier_price") @db.Decimal(12, 2) // cached; recomputed as unitsCommitted changes

  deadline DateTime
  status   CampaignStatus @default(OPEN)

  createdAt DateTime @default(now()) @map("created_at")

  commitments Commitment[]
  payouts     SupplierPayout[]

  @@index([productId])
  @@index([status, deadline])
  @@map("campaigns")
}

model Commitment {
  id       String @id @default(cuid())
  quantity Int

  priceLockedInNaira Decimal       @map("price_locked_in_naira") @db.Decimal(12, 2) // tier snapshot at commit time
  paymentStatus      PaymentStatus @default(PENDING) @map("payment_status")

  campaignId String   @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  payments  Payment[]

  @@index([campaignId])
  @@index([userId])
  @@map("commitments")
}

model Payment {
  id                String           @id @default(cuid())
  amountNaira       Decimal          @map("amount_naira") @db.Decimal(12, 2)
  paystackReference String?          @unique @map("paystack_reference")
  status            PaymentTxnStatus @default(PENDING)
  paidAt            DateTime?        @map("paid_at")

  commitmentId String     @map("commitment_id")
  commitment   Commitment @relation(fields: [commitmentId], references: [id])

  @@index([commitmentId])
  @@map("payments")
}

model ExchangeRateSnapshot {
  id           String   @id @default(cuid())
  rmbToNgnRate Decimal  @map("rmb_to_ngn_rate") @db.Decimal(12, 4)
  usdToNgnRate Decimal  @map("usd_to_ngn_rate") @db.Decimal(12, 4)
  source       String
  capturedAt   DateTime @default(now()) @map("captured_at")

  @@index([capturedAt])
  @@map("exchange_rate_snapshots")
}

model SupplierPayout {
  id               String       @id @default(cuid())
  amountRmb        Decimal      @map("amount_rmb") @db.Decimal(12, 2)
  amountUsd        Decimal?     @map("amount_usd") @db.Decimal(12, 2)
  exchangeRateUsed Decimal      @map("exchange_rate_used") @db.Decimal(12, 4)
  status           PayoutStatus @default(PENDING)
  notes            String?

  campaignId String   @map("campaign_id")
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  supplierId String   @map("supplier_id")
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([campaignId])
  @@index([supplierId])
  @@map("supplier_payouts")
}
