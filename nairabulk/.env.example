# Supabase → Project Settings → Database → Connection string (URI)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# Auth note: for the signup → onboarding flow to log users in immediately,
# turn OFF "Confirm email" in Supabase → Authentication → Providers → Email.
# With it ON, signup instead redirects to /login?checkEmail=1.

# Paystack → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY="sk_test_YOUR_SECRET"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_YOUR_PUBLIC"

# exchangerate-api.com free tier (https://www.exchangerate-api.com)
EXCHANGERATE_API_KEY="YOUR_FX_KEY"
# Margin below this % (of selling price) gets flagged in the admin margin check.
MARGIN_THRESHOLD_PCT="15"
