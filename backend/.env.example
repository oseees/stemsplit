# --- CORS: comma-separated list of allowed frontend origins ---
ALLOWED_ORIGINS=http://localhost:3000

# --- Storage: where uploads/outputs/jobs/licenses live (use a mounted volume in prod) ---
DATA_DIR=./

# --- PayPal (one-time Pro unlock) ---
# Create an app at https://developer.paypal.com/dashboard/applications/sandbox
# Use sandbox credentials first, then switch to live.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox          # "sandbox" or "live"
PRO_PRICE=9.99
PRO_CURRENCY=USD

# Optional: enables webhook signature verification (refunds/disputes auto-revoke Pro).
# Create a webhook in the PayPal dashboard pointing at  https://api.yourdomain.com/payments/webhook
# subscribed to PAYMENT.CAPTURE.REFUNDED, PAYMENT.CAPTURE.REVERSED, CUSTOMER.DISPUTE.CREATED,
# then paste its Webhook ID here. Leave blank to skip verification (testing only).
PAYPAL_WEBHOOK_ID=
