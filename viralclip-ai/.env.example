# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set true to explore the full UI without Supabase login. Dev only — never in prod.
DEMO_MODE=false

# ── AI (OpenAI-compatible) ────────────────────────────────
# Works with OpenAI, OpenRouter, Together, Groq, local vLLM, etc.
AI_API_KEY=your-ai-api-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# ── Speech-to-text (separate provider — Claude has no STT) ─
# Defaults to Groq: free tier, OpenAI-compatible, segment timestamps.
# Get a key at https://console.groq.com (no card required).
# Other OpenAI-compatible STT endpoints (OpenAI, local Whisper) also work —
# just change STT_BASE_URL + STT_MODEL.
STT_API_KEY=your-groq-api-key
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo
# Optional text-to-speech (also not available on Claude)
AI_TTS_MODEL=tts-1
AI_TTS_VOICE=alloy

# ── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PRICE_PRO=price_xxx
NEXT_PUBLIC_STRIPE_PRICE_AGENCY=price_xxx

# ── Storage / Processing ──────────────────────────────────
# UploadThing — stores raw video uploads (bypasses Supabase's size cap).
# Create an app at https://uploadthing.com → API Keys → copy the token.
UPLOADTHING_TOKEN=your-uploadthing-token
# Bucket name created in Supabase Storage (still used for exported clips/thumbs)
SUPABASE_UPLOAD_BUCKET=uploads
# Path to ffmpeg binary if not on PATH (optional)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
