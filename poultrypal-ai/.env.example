# Copy to .env (local) or set these as service variables on your host (Railway, etc.).
# The app reads these at startup.

# Required for the AI reasoning + image (vision) steps. Without it, the app still
# runs and retrieval still works, but /api/diagnose returns a 503 explaining the key is missing.
ANTHROPIC_API_KEY=

# Model used for reasoning + vision. Opus 4.8 is the default (multimodal, strong reasoning).
POULTRYPAL_MODEL=claude-opus-4-8

# How many knowledge passages to retrieve per diagnosis.
POULTRYPAL_TOP_K=6

# --- WhatsApp bot (optional; Meta WhatsApp Cloud API) ----------------------
# Leave blank to run without WhatsApp. To go live, create a Meta WhatsApp Business
# app and set all three, then point the webhook at https://<host>/whatsapp/webhook.
WHATSAPP_VERIFY_TOKEN=poultrypal-verify
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Deploy (optional) -----------------------------------------------------
# Where the sqlite case/feedback DB lives. Set to a mounted volume path to persist
# it across redeploys. The Docker image already defaults this to /app/data.
# POULTRYPAL_DATA_DIR=/app/data
